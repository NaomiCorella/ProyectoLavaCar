@{
    ViewBag.Title = "Margen de Ventas y Total de Ventas";
    var margenVentas = ViewBag.MargenVentas;
    var margenPorcentualVentas = ViewBag.MargenPorcentualVentas;
    var totalVentas = ViewBag.TotalVentas;
}

<h2 class="text-center mt-4">Margen de Ventas</h2>

<!-- Contenedor responsive con Bootstrap -->
<div class="container mt-4">
    <div class="row justify-content-center">

        <!-- Panel 1 -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
            <div class="panel h-100">
                <h3>Margen de Ventas</h3>
                <p class="margen" style="color: #27ae60;">
                    ₡ @margenVentas.ToString("N2")
                </p>
            </div>
        </div>

        <!-- Panel 2 -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
            <div class="panel h-100">
                <h3>Margen Porcentual de Ventas</h3>
                <p class="margen" style="color: #e67e22;">
                    @margenPorcentualVentas.ToString("N2")%
                </p>
            </div>
        </div>

        <!-- Panel 3 -->
        <div class="col-12 col-md-6 col-lg-4 mb-4">
            <div class="panel h-100">
                <h3>Total Ventas</h3>
                <p class="margen" style="color: #3498db;">
                    ₡ @totalVentas.ToString("N2")
                </p>
            </div>
        </div>

    </div>
</div>

<!-- Estilos personalizados -->
<style>
    .panel {
        border: 2px solid #ddd;
        padding: 20px;
        border-radius: 8px;
        background-color: #f7f7f7;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        transition: transform 0.2s ease-in-out;
    }

        .panel:hover {
            transform: translateY(-4px);
        }

        .panel h3 {
            color: #333;
            font-size: 22px;
            margin-bottom: 15px;
        }

    .margen {
        font-size: 20px;
        font-weight: bold;
    }
</style>