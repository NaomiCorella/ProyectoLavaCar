@model IEnumerable<ProyectoLavacar.Abstraciones.Modelos.ModuloNomina.TramitesDto>

@{
    ViewBag.Title = "Gestión de Trámites";
}

<!DOCTYPE html>
<html lang="zxx">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Gestión de Trámites</title>
    <link href="~/Content/assets/css/animate.css" rel="stylesheet" />
    <link href="~/Content/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/css/default.css" rel="stylesheet" />
    <link href="~/Content/assets/css/magnific-popup.css" rel="stylesheet" />
    <link href="~/Content/assets/css/slick.css" rel="stylesheet" />
    <link href="~/Content/assets/css/style.css" rel="stylesheet" />
    <link href="~/Content/assets/fonts/flaticon/flaticon.css" rel="stylesheet" />
    <link href="~/Content/assets/fonts/fontawesome/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css">

</head>

<body>
    <div class="luxury-tramites-container">
        <div class="container">
            <div class="section-title text-center">
                <div class="luxury-icon">
                    <svg viewBox="0 0 24 24">
                        <path fill="currentColor" d="M16 2H8C6.9 2 6 2.9 6 4V20C6 21.1 6.9 22 8 22H16C17.1 22 18 21.1 18 20V4C18 2.9 17.1 2 16 2M10 17H14V19H10V17M10 13H14V15H10V13M10 9H14V11H10V9M10 5H14V7H10V5Z" />
                    </svg>
                </div>
                <h2 class="luxury-title">Gestión de Trámites</h2>
                <p class="luxury-subtitle">Listado completo de trámites registrados</p>
                <div class="luxury-divider"></div>
            </div>
            <div class="luxury-card">

                <div class="text-center mb-4">
                    @Html.ActionLink(
                        "Registrar trámites",
                        "IngresarTramites",
                        new { idNomina = ViewBag.idNomina },
                        new { @class = "luxury-button luxury-button-primary" }
                    )
                </div>

                <div class="luxury-table-container">
                    <table class="luxury-table" id="myTable">
                        <thead class="luxury-table-header">
                            <tr>
                                <th style="text-align: center; vertical-align: middle;">Tipo</th>
                                <th style="text-align: center; vertical-align: middle;">Fecha Inicio</th>
                                <th style="text-align: center; vertical-align: middle;">Duración</th>
                                <th style="text-align: center; vertical-align: middle;">Razón</th>
                                <th style="text-align: center; vertical-align: middle;">Estado</th>
                                <th style="text-align: center; vertical-align: middle;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="luxury-table-row">
                                    <td>
                                        <span class="luxury-badge2 @(item.tipo == "Vacaciones" ? "vacaciones" : "incapacidad")">
                                            @Html.DisplayFor(modelItem => item.tipo)
                                        </span>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.FechaInicio)</td>
                                    <td>@Html.DisplayFor(modelItem => item.duracion)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Razon)</td>
                                    <td>
                                        @if (item.tipo == "Vacaciones")
                                        {

                                            if (item.estado == 0)
                                            {
                                                <span class="luxury-badge2">Pendiente</span>
                                            }
                                            if (item.estado == 1)
                                            {
                                                <span class="luxury-badge2">Aceptada</span>
                                            }
                                            if (item.estado == 2)
                                            {
                                                <span class="luxury-badge2">Denegada</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="luxury-badge2">Aceptada</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.tipo == "Vacaciones" && item.estado == 0)
                                        {
                                            @Html.ActionLink("Aceptar", "AceptarVacacion", new { idTramite = item.IdTramite },
                                            new { @class = "luxury-button luxury-button-success luxury-button-sm" })
                                        }
                                        else if (item.tipo == "Vacaciones")
                                        {
                                            <span class="luxury-status-text">Procesado</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="text-center mt-4 mb-4">

                        <a href="@Url.Action("ProcesosYGestiones", new { idNomina = ViewBag.idNomina })" class="luxury-button luxury-button-secondary">
                            <span class="button-text">Volver</span>
                            <span class="button-icon">
                                <svg viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                                </svg>
                            </span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Content/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/Content/assets/js/vendor/modernizr-3.6.0.min.js"></script>
    <script src="~/Content/assets/js/bootstrap.min.js"></script>
    <script src="~/Content/assets/js/imagesloaded.pkgd.min.js"></script>
    <script src="~/Content/assets/js/isotope.pkgd.min.js"></script>
    <script src="~/Content/assets/js/jquery.counterup.min.js"></script>
    <script src="~/Content/assets/js/jquery.magnific-popup.min.js"></script>
    <script src="~/Content/assets/js/main.js"></script>
    <script src="~/Content/assets/js/popper.min.js"></script>
    <script src="~/Content/assets/js/slick.min.js"></script>
    <script src="~/Content/assets/js/waypoints.min.js"></script>
    <script src="~/Content/assets/js/wow.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let table = new DataTable('#myTable', {
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],  // Opciones de cantidad de registros
                searching: false,  // Elimina la caja de búsqueda
                language: {
                    lengthMenu: 'Mostrar _MENU_ registros por página',
                    zeroRecords: 'No se encontraron registros',
                    info: 'Mostrando página _PAGE_ de _PAGES_',
                    infoEmpty: 'No hay registros disponibles',
                    infoFiltered: '(filtrado de _MAX_ registros en total)',
                    paginate: {
                        first: 'Primera',
                        previous: 'Anterior',
                        next: 'Siguiente',
                        last: 'Última'
                    }
                }
            });
        });

    </script>


    <script>
        // Agregar etiquetas para responsive
        $(document).ready(function () {
            $('.luxury-table-row td').each(function () {
                var header = $(this).parent().find('th').eq($(this).index()).text();
                $(this).attr('data-label', header);
            });
        });
    </script>
</body>
</html>

<style>

    .luxury-button-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #adb5bd 100%);
        box-shadow: 0 10px 20px rgba(108, 117, 125, 0.2);
    }

    .luxury-tramites-container {
        padding: 40px 0;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .section-title {
        margin-bottom: 40px;
        position: relative;
    }

    .luxury-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
        border-radius: 50%;
        color: white;
        box-shadow: 0 10px 30px rgba(69, 196, 176, 0.3);
    }

        .luxury-icon svg {
            width: 40px;
            height: 40px;
        }

    .luxury-title {
        font-size: 32px;
        font-weight: 600;
        color: #012030;
        margin-bottom: 15px;
    }

    .luxury-subtitle {
        color: #6c757d;
        font-size: 18px;
        max-width: 600px;
        margin: 0 auto 20px;
    }

    .luxury-divider {
        width: 80px;
        height: 3px;
        background: linear-gradient(90deg, #45C4B0 0%, #9AEBA3 100%);
        margin: 20px auto;
        border-radius: 3px;
    }

    .luxury-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin: 0 auto;
        padding: 30px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .luxury-table-container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        overflow-x: auto;
    }


    .luxury-table {
        width: 110%;
        border-collapse: collapse;
        font-size: 15px;
    }


        .luxury-table thead {
            background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
            color: white;
        }

    .luxury-table-header th {
        text-align: center; /* Centra horizontalmente el texto */
        vertical-align: middle; /* Centra verticalmente el contenido */
    }


    .luxury-table th {
        padding: 15px 20px;
        text-align: left;
        font-weight: 600;
    }

    .luxury-table td {
        padding: 18px;
        text-align: center;
        font-weight: 600;
    }

    .luxury-table-row {
        border-bottom: 1px solid #e0e0e0;
        transition: background-color 0.3s ease;
    }

        .luxury-table-row:hover {
            background-color: rgba(69, 196, 176, 0.05);
        }

        .luxury-table-row td {
            padding: 16px;
            vertical-align: middle;
            text-align: center;
        }


    .luxury-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        color: white;
    }

    .luxury-badge2 {
        display: inline-block;
        min-width: 80px;
        text-align: center;
        padding: 5px 12px;
        border-radius: 20px;
        font-weight: bold;
        white-space: nowrap;
        color: black;
    }



    .luxury-status {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        color: white;
    }

        .luxury-status.pendiente {
            background-color: #ffc107;
        }

        .luxury-status.revisado {
            background-color: #28a745;
        }

    .luxury-status-text {
        color: #6c757d;
        font-style: italic;
    }

    .luxury-button {
        position: relative;
        padding: 12px 24px;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        overflow: hidden;
        transition: all 0.4s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
    }

    .luxury-button-primary {
        background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
        color: white;
    }

    .luxury-button-sm {
        padding: 8px 16px;
        font-size: 14px;
    }

    .luxury-button-warning {
        background: linear-gradient(135deg, #003366 0%, #9AEBA3 100%);
        box-shadow: 0 10px 20px rgba(69, 196, 176, 0.2);
    }

    .luxury-button-success {
        background: transparent;
        border: 2px solid #28a745; /* borde verde */
        color: #28a745; /* texto en verde */
        box-shadow: none; /* sin sombra */
        transition: all 0.3s ease;
    }

        .luxury-button-success:hover {
            background-color: #28a745; /* se llena de verde al hacer hover */
            color: white; /* texto blanco */
        }

    .button-text {
        position: relative;
        z-index: 2;
    }

    .button-icon {
        position: relative;
        z-index: 2;
        display: flex;
        transition: transform 0.3s ease;
    }

        .button-icon svg {
            width: 18px;
            height: 18px;
        }

    .button-shine {
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.6s ease;
    }

    .luxury-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        text-decoration: none;
    }

        .luxury-button:hover .button-shine {
            left: 100%;
        }

        .luxury-button:hover .button-icon {
            transform: translateX(5px);
        }

    /* Animaciones */
    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .luxury-icon {
        animation: float 4s ease-in-out infinite;
    }

    @@media (max-width: 768px) {
        .luxury-card {
            padding: 0;
        }

        .luxury-title {
            font-size: 28px;
        }

        .luxury-subtitle {
            font-size: 16px;
        }

        .luxury-table th,
        .luxury-table td {
            padding: 10px 15px;
            display: block;
            text-align: right;
        }

            .luxury-table th::before,
            .luxury-table td::before {
                content: attr(data-label);
                float: left;
                font-weight: bold;
            }

        .luxury-table thead {
            display: none;
        }

        .luxury-table tr {
            margin-bottom: 15px;
            display: block;
            border-bottom: 2px solid #f0f0f0;
        }

        .luxury-button {
            width: 100%;
            margin-bottom: 10px;
        }
    }

    /* Bordes ovalados arriba del thead */
    .luxury-table thead th:first-child {
        border-top-left-radius: 12px;
    }

    .luxury-table thead th:last-child {
        border-top-right-radius: 12px;
    }
</style>