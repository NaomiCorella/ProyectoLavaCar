@model IEnumerable<ProyectoLavacar.Abstraciones.Modelos.ModuloNomina.AjustesSalarialesDto>

@{
    ViewBag.Title = "Ajustes Salariales";
}

<!DOCTYPE html>
<html lang="zxx">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Ajustes Salariales</title>
    <link href="~/Content/assets/css/animate.css" rel="stylesheet" />
    <link href="~/Content/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/css/default.css" rel="stylesheet" />
    <link href="~/Content/assets/css/magnific-popup.css" rel="stylesheet" />
    <link href="~/Content/assets/css/slick.css" rel="stylesheet" />
    <link href="~/Content/assets/css/style.css" rel="stylesheet" />
    <link href="~/Content/assets/fonts/flaticon/flaticon.css" rel="stylesheet" />
    <link href="~/Content/assets/fonts/fontawesome/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.2.2/css/dataTables.dataTables.min.css">

</head>

<body>
    <div class="luxury-ajustes-container">
        <div class="container">
            <div class="section-title text-center">
                <div class="luxury-icon">
                    <svg viewBox="0 0 24 24">
                        <path fill="currentColor" d="M12 1C12.56 1 13 1.45 13 2V4.08C13.72 4.21 14.4 4.46 15 4.81L16.41 3.41C16.79 3.03 17.41 3.03 17.79 3.41C18.17 3.79 18.17 4.41 17.79 4.79L16.38 6.2C16.73 6.8 16.98 7.48 17.11 8.2H19C19.55 8.2 20 8.65 20 9.2S19.55 10.2 19 10.2H17.11C16.98 10.92 16.73 11.6 16.38 12.2L17.79 13.61C18.17 13.99 18.17 14.61 17.79 14.99C17.41 15.37 16.79 15.37 16.41 14.99L15 13.58C14.4 13.93 13.72 14.18 13 14.31V16.2C13 16.75 12.55 17.2 12 17.2S11 16.75 11 16.2V14.31C10.28 14.18 9.6 13.93 9 13.58L7.59 14.99C7.21 15.37 6.59 15.37 6.21 14.99C5.83 14.61 5.83 13.99 6.21 13.61L7.62 12.2C7.27 11.6 7.02 10.92 6.89 10.2H5C4.45 10.2 4 9.75 4 9.2S4.45 8.2 5 8.2H6.89C7.02 7.48 7.27 6.8 7.62 6.2L6.21 4.79C5.83 4.41 5.83 3.79 6.21 3.41C6.59 3.03 7.21 3.03 7.59 3.41L9 4.82C9.6 4.46 10.28 4.21 11 4.08V2C11 1.45 11.45 1 12 1M9 18H15V20H9V18M9 21H15V23H9V21Z" />
                    </svg>
                </div>

                <h2 class="luxury-title">Ajustes Salariales</h2>
                <p class="luxury-subtitle">Listado completo de ajustes registrados</p>
                <div class="luxury-divider"></div>
            </div>
            <div class="luxury-card">
                <div class="text-center mb-4">
                    @Html.ActionLink(
                        "Registrar Nuevo Ajuste",
                        "IngresarAjustes",
                        new { idNomina = ViewBag.idNomina },
                        new { @class = "luxury-button luxury-button-primary" }
                    )
                </div>



                <div class="luxury-filter-container">
                    <form method="get" action="@Url.Action("FiltrarPorProducto", "Nomina")" class="luxury-filter-form">
                        <input type="hidden" name="idNomina" value="@ViewData["idNomina"]" />

                        <div class="row align-items-center">
                            <div class="col-md-4 mb-3 mb-md-0">
                                <select name="estado" class="luxury-form-select">
                                    <option value="">Todos los estados</option>
                                    <option value="true">Activo</option>
                                    <option value="false">Inactivo</option>
                                </select>
                            </div>
                            <div class="col-md-8 d-flex justify-content-end">
                                <button type="submit" class="luxury-button luxury-button-primary mr-2">
                                    <span class="button-text">Filtrar</span>
                                    <span class="button-icon">
                                        <svg viewBox="0 0 24 24">
                                            <path fill="currentColor" d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
                                        </svg>
                                    </span>
                                    <div class="button-shine"></div>
                                </button>

                                <a href="@Url.Action("ListarAjustes", "Nomina", new { idNomina = ViewData["idNomina"] })"
                                   class="luxury-button luxury-button-secondary">
                                    
                                    <span class="button-text">Restablecer</span>
                                    <span class="button-icon">
                                        <svg viewBox="0 0 24 24" width="20" height="20">
                                            <path fill="currentColor" d="M12,5V1L7,6L12,11V7C15.31,7 18,9.69 18,13C18,16.31 15.31,19 12,19C8.69,19 6,16.31 6,13H4C4,17.42 7.58,21 12,21C16.42,21 20,17.42 20,13C20,8.58 16.42,5 12,5Z" />
                                        </svg>
                                    </span>

                                    <div class="button-shine"></div>
                                </a>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="luxury-table-container">
                    <table class="luxury-table" id="myTable">
                        <thead class="luxury-table-header">
                            <tr>
                                <th style="text-align: center; vertical-align: middle;"> Tipo</th>
                                <th style="text-align: center; vertical-align: middle;"> Razón</th>
                                <th style="text-align: center; vertical-align: middle;"> Monto</th/>
                                <th style="text-align: center; vertical-align: middle;"> Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="luxury-table-row">
                                    <td>
                                        <span class="luxury-badge @(item.tipo == "Bono" ? "bono" : "deduccion")">
                                            @Html.DisplayFor(modelItem => item.tipo)
                                        </span>
                                    </td>
                                    <td>@Html.DisplayFor(modelItem => item.Razon)</td>
                                    <td class="luxury-amount @(item.tipo == "Bono" ? "positive" : "negative")">
                                        @Html.DisplayFor(modelItem => item.Monto)
                                    </td>
                                    <td>
                                        <a href="@Url.Action("AnularAjustes", new { id = item.IdAjusteSalarial })"
                                           class="luxury-btn-action btn-anular me-2 mb-2"
                                           title="Anular" data-bs-toggle="tooltip">
                                            <i class="fas fa-times-circle me-1"></i>
                                            Anular
                                        </a>
                                    </td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-center mt-4 mb-4">
                    <a href="@Url.Action("ProcesosYGestiones", new { idNomina = ViewBag.idNomina })" class="luxury-button luxury-button-secondary">
                        <span class="button-text">Volver</span>
                        <span class="button-icon">
                            <svg viewBox="0 0 24 24">
                                <path fill="currentColor" d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" />
                            </svg>
                        </span>
                    </a>
                </div>
            </div>

        </div>
    </div>
    
           
    

    <script src="~/Content/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/Content/assets/js/vendor/modernizr-3.6.0.min.js"></script>
    <script src="~/Content/assets/js/bootstrap.min.js"></script>
    <script src="~/Content/assets/js/imagesloaded.pkgd.min.js"></script>
    <script src="~/Content/assets/js/isotope.pkgd.min.js"></script>
    <script src="~/Content/assets/js/jquery.counterup.min.js"></script>
    <script src="~/Content/assets/js/jquery.magnific-popup.min.js"></script>
    <script src="~/Content/assets/js/main.js"></script>
    <script src="~/Content/assets/js/popper.min.js"></script>
    <script src="~/Content/assets/js/slick.min.js"></script>
    <script src="~/Content/assets/js/waypoints.min.js"></script>
    <script src="~/Content/assets/js/wow.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/2.2.2/js/dataTables.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let table = new DataTable('#myTable', {
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],  // Opciones de cantidad de registros
                searching: false,  // Elimina la caja de búsqueda
                language: {
                    lengthMenu: 'Mostrar _MENU_ registros por página',
                    zeroRecords: 'No se encontraron registros',
                    info: 'Mostrando página _PAGE_ de _PAGES_',
                    infoEmpty: 'No hay registros disponibles',
                    infoFiltered: '(filtrado de _MAX_ registros en total)',
                    paginate: {
                        first: 'Primera',
                        previous: 'Anterior',
                        next: 'Siguiente',
                        last: 'Última'
                    }
                }
            });
        });

    </script>


    <script>
        // Agregar etiquetas para responsive
        $(document).ready(function () {
            $('.luxury-table-row td').each(function () {
                var header = $(this).parent().find('th').eq($(this).index()).text();
                $(this).attr('data-label', header);
            });
        });
    </script>

</body>
</html>

<style>
    .luxury-filter-container {
        background: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 30px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    }

    .luxury-filter-input {
        padding: 12px 15px;
        border: 1px solid #ced4da;
        border-radius: 8px;
        font-size: 15px;
        transition: all 0.3s ease;
        width: 100%;
    }

        .luxury-filter-input:focus {
            border-color: #45C4B0;
            box-shadow: 0 0 0 3px rgba(69, 196, 176, 0.1);
            outline: none;
        }
    .luxury-ajustes-container {
        padding: 40px 0;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .section-title {
        margin-bottom: 40px;
        position: relative;
    }

    .luxury-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
        border-radius: 50%;
        color: white;
        box-shadow: 0 10px 30px rgba(69, 196, 176, 0.3);
    }

        .luxury-icon svg {
            width: 40px;
            height: 40px;
        }

    .luxury-title {
        font-size: 32px;
        font-weight: 600;
        color: #012030;
        margin-bottom: 15px;
    }

    .luxury-subtitle {
        color: #6c757d;
        font-size: 18px;
        max-width: 600px;
        margin: 0 auto 20px;
    }

    .luxury-divider {
        width: 80px;
        height: 3px;
        background: linear-gradient(90deg, #45C4B0 0%, #9AEBA3 100%);
        margin: 20px auto;
        border-radius: 3px;
    }

    .luxury-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        margin: 0 auto;
        padding: 30px;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .luxury-filter-form {
        padding: 20px;
    }

    .luxury-form-select {
        width: 100%;
        padding: 12px 20px;
        border: 2px solid #e9ecef;
        border-radius: 10px;
        font-size: 16px;
        transition: all 0.3s ease;
    }

        .luxury-form-select:focus {
            border-color: #45C4B0;
            box-shadow: 0 0 0 0.2rem rgba(69, 196, 176, 0.25);
            outline: none;
        }

    .luxury-table-container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        overflow-x: auto;
    }


    .luxury-table {
        width: 110%;
        border-collapse: collapse;
        font-size: 15px;
    }


        .luxury-table thead {
            background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
            color: white;
        }
    .luxury-table-header th {
        text-align: center; /* Centra horizontalmente el texto */
        vertical-align: middle; /* Centra verticalmente el contenido */
    }


        .luxury-table th {
            padding: 15px 20px;
            text-align: left;
            font-weight: 600;
        }

        .luxury-table td {
            padding: 18px;
            text-align: center;
            font-weight: 600;
        }

    .luxury-table-row {
        border-bottom: 1px solid #e0e0e0;
        transition: background-color 0.3s ease;
    }

        .luxury-table-row:hover {
            background-color: rgba(69, 196, 176, 0.05);
        }

        .luxury-table-row td {
            padding: 16px;
            vertical-align: middle;
            text-align: center;
        }

    .luxury-badge {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        color: #6d6d6d;
    }

/*        .luxury-badge.bono {
            background-color: #28a745;
        }

        .luxury-badge.deduccion {
            background-color: #dc3545;
        }*/

    .luxury-amount {
        font-weight: 600;
    }

/*        .luxury-amount.positive {
            color: #28a745;
        }

        .luxury-amount.negative {
            color: #dc3545;
        }*/

    .luxury-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }

    .luxury-button-primary {
        background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
        color: white;
    }

        .luxury-button-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 16px rgba(69, 196, 176, 0.3);
            color: white;
        }


    .luxury-button-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #adb5bd 100%);
        box-shadow: 0 10px 20px rgba(108, 117, 125, 0.2);
        color: white;
    }



    .luxury-button-secondary {
        background-color: #5dade2;
        color: white;
        border: 1px solid #5dade2;
    }

        .luxury-button-secondary:hover {
            background-color: #3498db;
            border-color: #3498db;
            box-shadow: 0 0 8px rgba(93, 173, 226, 0.4);
        }

    .luxury-button .icon {
        margin-right: 4px;
    }

    .btn-anular {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        font-size: 14px;
        font-weight: 600;
        color: white;
        background-color: #5dade2;
        border: 1px solid #5dade2;
        border-radius: 8px;
        text-decoration: none;
        transition: background-color 0.3s ease, box-shadow 0.3s ease;
    }

        .btn-anular:hover {
            background-color: #3498db;
            border-color: #3498db;
            box-shadow: 0 0 10px rgba(93, 173, 226, 0.4);
            text-decoration: none;
        }

        .btn-anular i {
            font-size: 16px;
        }


    .luxury-button .icon {
        margin-right: 4px;
    }



    .button-text {
        position: relative;
        z-index: 2;
    }

    .button-icon {
        position: relative;
        z-index: 2;
        display: flex;
        transition: transform 0.3s ease;
    }

        .button-icon svg {
            width: 18px;
            height: 18px;
        }

    .button-shine {
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.6s ease;
    }

    .luxury-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        text-decoration: none;
    }

        .luxury-button:hover .button-shine {
            left: 100%;
        }

        .luxury-button:hover .button-icon {
            transform: translateX(5px);
        }

    /* Animaciones */
    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .luxury-icon {
        animation: float 4s ease-in-out infinite;
    }

    @@media (max-width: 768px) {
        .luxury-card {
            padding: 0;
        }

        .luxury-title {
            font-size: 28px;
        }

        .luxury-subtitle {
            font-size: 16px;
        }

        

        .luxury-button {
            width: 100%;
            margin-bottom: 10px;
        }

        .luxury-table th,
        .luxury-table td {
            padding: 10px 15px;
        }
    }

    /* Bordes ovalados arriba del thead */
    .luxury-table thead th:first-child {
        border-top-left-radius: 12px;
    }

    .luxury-table thead th:last-child {
        border-top-right-radius: 12px;
    }
</style>