@{
    ViewBag.Title = "Error";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>No se puede ingresar más días de vacaciones</title>

    <!-- Estilos luxury -->
    <link href="~/Content/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/assets/css/style.css" rel="stylesheet" />
    <link href="~/Content/assets/fonts/fontawesome/css/all.min.css" rel="stylesheet" />
</head>
<body>

    <div class="luxury-nomina-container d-flex justify-content-center align-items-center">
        <div class="luxury-card shadow-lg rounded text-center p-5">
            <div class="luxury-icon mx-auto mb-4">
                <svg viewBox="0 0 24 24">
                    <path fill="currentColor" d="M11,15H13V17H11V15M12,2A10,10 0 0,0 2,12C2,16.42 5.58,20 10,20H14C18.42,20 22,16.42 22,12A10,10 0 0,0 12,2M12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6A6,6 0 0,1 18,12A6,6 0 0,1 12,18Z" />
                </svg>
            </div>

            <h2 class="luxury-title mb-3">No se puede ingresar más días de vacaciones</h2>
            <p class="luxury-subtitle mb-4">Ha usado todos los días de vacaciones disponibles.</p>

            <div class="d-flex justify-content-center gap-2 mt-4 flex-wrap">
                <a href="@Url.Action("Index", "Home")" class="luxury-button luxury-button-secondary">
                <span class="button-text">Volver al Index</span>
                <span class="button-icon">
                    <svg viewBox="0 0 24 24">
                        <path fill="currentColor" d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" />
                    </svg>
                </span>
                <div class="button-shine"></div>
                </a>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/Content/assets/js/vendor/jquery-1.12.4.min.js"></script>
    <script src="~/Content/assets/js/bootstrap.min.js"></script>
    <script src="~/Content/assets/js/main.js"></script>
</body>
</html>
<style>
    .luxury-nomina-container {
        padding: 40px 0;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        min-height: 100vh;
    }

    .section-title {
        margin-bottom: 40px;
        position: relative;
    }

    .luxury-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
        border-radius: 50%;
        color: white;
        box-shadow: 0 10px 30px rgba(69, 196, 176, 0.3);
    }

        .luxury-icon svg {
            width: 40px;
            height: 40px;
        }

    .luxury-title {
        font-size: 32px;
        font-weight: 600;
        color: #012030;
        margin-bottom: 15px;
    }

    .luxury-subtitle {
        color: #6c757d;
        font-size: 18px;
        max-width: 600px;
        margin: 0 auto 20px;
    }

    .luxury-divider {
        width: 80px;
        height: 3px;
        background: linear-gradient(90deg, #45C4B0 0%, #9AEBA3 100%);
        margin: 20px auto;
        border-radius: 3px;
    }

    .luxury-card {
        background: white;
        border-radius: 16px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        max-width: 1200px;
        margin: 0 auto;
        border: 1px solid rgba(255, 255, 255, 0.3);
    }

    .luxury-card-header {
        background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
        color: white;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .luxury-employee-id {
        background: rgba(255, 255, 255, 0.2);
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 14px;
    }

    .luxury-info-group {
        margin-bottom: 25px;
    }

    .luxury-info-title {
        color: #45C4B0;
        font-size: 18px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        padding-bottom: 8px;
        border-bottom: 2px solid #f0f0f0;
    }

    .luxury-info-item {
        display: flex;
        justify-content: space-between;
        margin-bottom: 12px;
        padding: 8px 0;
        border-bottom: 1px dashed #f0f0f0;
    }

    .luxury-info-label {
        font-weight: 600;
        color: #495057;
    }

    .luxury-info-value {
        color: #6c757d;
        text-align: right;
    }

    .luxury-amount {
        font-weight: 600;
    }

        .luxury-amount.positive {
            color: #28a745;
        }

        .luxury-amount.negative {
            color: #dc3545;
        }

        .luxury-amount.highlight {
            color: #007bff;
            font-size: 18px;
        }

    .luxury-button {
        position: relative;
        width: 100%;
        max-width: 250px;
        padding: 16px;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        overflow: hidden;
        transition: all 0.4s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        text-decoration: none;
        margin: 0 10px;
    }

    .luxury-button-primary {
        background: linear-gradient(135deg, #45C4B0 0%, #9AEBA3 100%);
        box-shadow: 0 10px 20px rgba(69, 196, 176, 0.2);
    }

    .luxury-button-success {
        background: linear-gradient(135deg, #28a745 0%, #5cb85c 100%);
        box-shadow: 0 10px 20px rgba(40, 167, 69, 0.2);
    }

    .luxury-button-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #adb5bd 100%);
        box-shadow: 0 10px 20px rgba(108, 117, 125, 0.2);
    }

    .button-text {
        position: relative;
        z-index: 2;
    }

    .button-icon {
        position: relative;
        z-index: 2;
        display: flex;
        transition: transform 0.3s ease;
    }

        .button-icon svg {
            width: 20px;
            height: 20px;
        }

    .button-shine {
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
        transition: left 0.6s ease;
    }

    .luxury-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.2);
        text-decoration: none;
    }

        .luxury-button:hover .button-shine {
            left: 100%;
        }

        .luxury-button:hover .button-icon {
            transform: translateX(5px);
        }

    /* Animaciones */
    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .luxury-icon {
        animation: float 4s ease-in-out infinite;
    }

    @@media (max-width: 768px) {
        .luxury-card {
            padding: 0;
        }

        .luxury-title {
            font-size: 28px;
        }

        .luxury-subtitle {
            font-size: 16px;
        }

        .luxury-info-item {
            flex-direction: column;
        }

        .luxury-info-label,
        .luxury-info-value {
            width: 100%;
            text-align: left;
        }

        .luxury-info-value {
            margin-top: 5px;
        }

        .luxury-button {
            max-width: 100%;
            margin-bottom: 15px;
        }
    }
</style>
